{
  "name": "sabjiilelo",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "turbo run dev --filter=@sabjiilelo/api --filter=@sabjiilelo/web",
    "dev:api": "pnpm --filter @sabjiilelo/api dev",
    "dev:web": "pnpm --filter @sabjiilelo/web dev",
    "dev:mobile": "pnpm --filter @sabjiilelo/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @sabjiilelo/api db:migrate",
    "db:seed": "pnpm --filter @sabjiilelo/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~5.8.3"
  }
}
