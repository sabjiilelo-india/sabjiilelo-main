NODE_ENV=development
PORT=4000
# Pooled URL for the running app, direct URL for migrations (Neon / Render Postgres)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

JWT_SECRET=change-me-access
REFRESH_SECRET=change-me-refresh
# Comma separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173
# Public base URL of this API (used for locally stored uploads)
PUBLIC_URL=http://localhost:4000

# OTP: "fixed" accepts OTP_FIXED for every phone, no SMS is sent
OTP_MODE=fixed
OTP_FIXED=9999

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=Sabjii@123
SUPERADMIN_PHONE=9000000000

# Leave Razorpay empty to use the built-in mock checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Leave empty to store uploads on local disk under ./uploads.
# Set either CLOUDINARY_URL (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) or the three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, only needed with Expo push security enabled
EXPO_ACCESS_TOKEN=
